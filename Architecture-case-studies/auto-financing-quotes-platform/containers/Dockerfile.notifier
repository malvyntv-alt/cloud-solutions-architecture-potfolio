FROM public.ecr.aws/lambda/python:3.12
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt --target "${LAMBDA_TASK_ROOT}"
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem','/var/task/rds-ca.pem')"
ENV RDS_CA_BUNDLE=/var/task/rds-ca.pem APP_MODE=aws
COPY app ${LAMBDA_TASK_ROOT}/app
CMD ["app.lambda_handler.handler"]

